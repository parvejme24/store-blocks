{
  "name": "create-storeblocks",
  "version": "0.1.0",
  "description": "Scaffold a production-ready, full-stack e-commerce store in minutes",
  "bin": {
    "create-storeblocks": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "prepack": "npm run build && node scripts/copy-templates.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2"
  }
}
