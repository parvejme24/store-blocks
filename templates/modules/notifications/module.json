{
  "name": "notifications",
  "label": "Email Notifications",
  "description": "Transactional email notifications using Nodemailer for order confirmations and shipping updates.",
  "type": "feature",
  "dependsOn": ["orders"],
  "uses": [],
  "dependencies": {
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17"
  },
  "env": [
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM"
  ],
  "backend": {
    "basePath": "/api/notifications"
  },
  "since": "0.1.0"
}

