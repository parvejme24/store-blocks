{
  "name": "storeblocks-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "StoreBlocks monorepo: CLI scaffolder, module kit, and templates",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces --if-present dev",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "validate:manifests": "tsx packages/module-kit/src/validate-manifests.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "tsx": "^4.19.3"
  }
}
